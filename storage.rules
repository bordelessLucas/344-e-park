rules_version = '2';
// Cole estas regras em Firebase Console → Storage → Regras (projeto e-park-25aa8, mesmo do src/lib/firebase.ts)
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }
  }
}
