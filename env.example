# Copie para .env e preencha (Expo carrega EXPO_PUBLIC_* no bundle).

# Google Places — postos + recarga elétrica próximos (opcional).
# Sem chave: OpenStreetMap (Overpass, espelhos públicos) + geocodificação reversa Photon (Komoot), sem custo.
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Catálogo JSON de baterias (opcional; mesmo formato que BatteryProduct[]).
# EXPO_PUBLIC_BATTERY_CATALOG_URL=

# Backend próprio para multas / IPVA / licenciamento (opcional).
# O app chama: GET {BASE}/vehicle/{PLACA}  (Bearer opcional se EXPO_PUBLIC_VEHICLE_INFO_API_KEY estiver definida)
# Resposta JSON: plate, fines[], ipva[], licensing{ status, expiryDate, daysUntilExpiry }, totalFinesPending?, totalFinesPendingValue?
# Sem BASE: tela usa simulação determinística (mesma placa → mesmos números), com aviso na UI.
# EXPO_PUBLIC_VEHICLE_INFO_API_BASE=https://api.seudominio.com
# EXPO_PUBLIC_VEHICLE_INFO_API_KEY=
